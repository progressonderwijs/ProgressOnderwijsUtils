<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\NugetPackagesCommon.props" />
  <PropertyGroup>
    <Version>12.0.0</Version>
    <PackageReleaseNotes>Upgraded to .Net 11.</PackageReleaseNotes>
    <Title>ProgressOnderwijsUtils.AspNetCore</Title>
    <Description>Add Cross-Origin-Embedder-Policy and Cross-Origin-Opener-Policy to the default set of headers set.</Description>
    <PackageTags>ProgressOnderwijs</PackageTags>
    <TargetFramework>net11.0</TargetFramework>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="11.0.100" />
  </ItemGroup>
</Project>
